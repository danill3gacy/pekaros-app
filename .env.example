# ---- Telegram ----
# Токен бота: напишите @BotFather в Telegram -> /newbot -> скопируйте токен
BOT_TOKEN=

# Кому слать утреннюю сводку. Узнать свой chat_id: запустите бота, напишите /start
# Несколько получателей — через запятую (владелец, управляющий)
BRIEF_CHAT_IDS=

# Кому вечернее напоминание про списания (по умолчанию — те же, что сводка)
STAFF_CHAT_IDS=

# Время утренней сводки, вечернего напоминания про списания и часовой пояс
BRIEF_TIME=06:30
CLOSE_TIME=20:30
TIMEZONE=Europe/Moscow

# Через сколько часов без новых данных бот предупредит владельца
DATA_STALE_HOURS=28

# ---- Автозагрузка чеков (чтобы каждый чек попадал сам) ----
# off    — выключено (грузите вручную: python -m coffeeos import файл.csv)
# folder — система сама берёт CSV из папки ниже (касса/выгрузка складывает туда файлы)
# http   — система сама забирает чеки по API кассы/ОФД
SYNC_MODE=off
SYNC_INTERVAL_MIN=60
# для folder:
SYNC_FOLDER=
# для http (API кассы/ОФД):
SYNC_URL=
SYNC_TOKEN=

# ---- Доступ к сайту (веб-дашборду) ----
# Задайте пароль на боевом сервере — иначе выручку увидит любой, кто знает адрес.
WEB_USER=owner
WEB_PASSWORD=

# ---- Экономика ----
# Цены сырья живут в базе и правятся из бота («цена зерно 1800»), а не здесь:
# их несколько десятков и они меняются. Тут только пороги расчётов.

# Порог, с которого система считает, что позиция витрины РАСПРОДАНА, а не
# просто перестала пользоваться спросом. Меньше = строже (меньше ложных
# срабатываний). Менять обычно не нужно.
SELLOUT_P=0.05

# Целевой уровень сервиса ВИТРИНЫ: какую долю спроса на еду стремимся закрыть.
# Выше — реже остаётесь без завтраков, но больше списаний. Напитков не
# касается: они делаются на заказ и кончиться не могут.
CASE_SERVICE_LEVEL=70

# Ориентир по фудкосту для подсветки позиций в разборе меню. Это ориентир,
# а не норматив: сравнивать позицию имеет смысл с соседями по своей же витрине.
TARGET_FOODCOST=30

# На сколько дней вперёд считается заявка поставщику (ваш обычный цикл закупки).
# Скоропорт система всё равно закажет на свой срок и скажет об этом отдельно.
ORDER_HORIZON_DAYS=7

# ---- Резервные копии базы ----
# сколько копий хранить
BACKUP_KEEP=14
# во сколько ночью делать копию
BACKUP_HOUR=4
# пусто = папка backups рядом с базой
BACKUP_DIR=

# ---- Заведение ----
VENUE_NAME=Кофейня
OWNER_NAME=Саша

# Telegram chat_id поставщика (по желанию). Если задан — бот отправляет заявку ему сам.
# Если пусто — владелец пересылает готовую заявку поставщику (WhatsApp и т.п.).
SUPPLIER_CHAT_ID=

# ---- База данных ----
# Путь к файлу SQLite (по умолчанию рядом с проектом)
# DB_PATH=/opt/coffeeos/coffeeos.db

# ---- ИИ для свободных вопросов ----
# Кнопки и частые вопросы работают БЕЗ ИИ и бесплатно. ИИ нужен, чтобы бот
# отвечал на ЛЮБОЙ свободный вопрос владельца по данным кофейни.
#
# ПО УМОЛЧАНИЮ подключена БЕСПЛАТНАЯ локальная модель Ollama qwen2.5:3b:
#   данные не покидают машину (152-ФЗ), платить не нужно, из России работает.
#   Один раз: установить Ollama, затем `ollama serve` и `ollama pull qwen2.5:3b`.
#   Проверить связь: python -m coffeeos llm
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=qwen2.5:3b
LLM_API_KEY=ollama

# Сколько секунд ждать ответа модели (qwen2.5:3b на слабом ноутбуке бывает медленной).
LLM_TIMEOUT=60

# --- Альтернативы (оставьте выше пустым, если используете одну из них) ---
# Groq/OpenRouter (бесплатный лимит, OpenAI-совместимые):
#   LLM_BASE_URL=https://api.groq.com/openai/v1
#   LLM_MODEL=llama-3.1-8b-instant
#   LLM_API_KEY=ваш_ключ
# Облако OpenAI (нужен баланс):
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
